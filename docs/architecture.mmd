%%{init: {'theme':'base','themeVariables':{'fontFamily':'Helvetica, Arial, sans-serif','primaryColor':'#eef4ff','primaryBorderColor':'#3b6fd6','lineColor':'#3b3b3b','fontSize':'14px'}}}%%
flowchart LR

subgraph PO["Prompt Opinion platform"]
  direction TB
  POEHR["EHR session<br/>SMART-on-FHIR token<br/>+ patient in context"]
  POAdmin["Configuration → MCP Servers<br/>(user authorizes SMART scopes)"]
  POInvoker["Tool invoker<br/>(HTTP POST /mcp<br/>+ FHIR context headers)"]
  POEHR --> POInvoker
  POAdmin --> POInvoker
end

subgraph SUT["Suture (your deployed Go server)"]
  direction TB

  subgraph HTTP_LAYER["HTTP transport"]
    direction TB
    HTTPHandler["POST /mcp<br/>(JSON-RPC 2.0)"]
    InitResp["initialize response<br/>declares ai.promptopinion/fhir-context<br/>with patient/Patient.rs, patient/Condition.rs, …"]
    HTTPHandler --> InitResp
  end

  subgraph CONTEXT_LAYER["FHIR context middleware"]
    direction TB
    HeaderExtract["Read HTTP headers:<br/>X-FHIR-Server-URL<br/>X-FHIR-Access-Token<br/>X-Patient-ID"]
    CtxInject["Inject typed fhircontext.Context<br/>into context.Context"]
    HeaderExtract --> CtxInject
  end

  subgraph WEFT_LAYER["weft composition"]
    direction TB
    ArrowType["Arrow[A,B] = func(ctx, A) (B, error)"]
    Combinators["Compose · Pipe3 · Par · Traverse · Apply"]
    Loop["agent.Loop (Arrow[Prompt, Response])"]
  end

  subgraph TOOL_LAYER["Five healthcare tools"]
    direction TB
    T1["get_patient_summary<br/>Par(ReadPatient, SearchConditions) + Map"]
    T2["calculate_cha2ds2_vasc<br/>Pipe3(fetch, extract, score)"]
    T3["get_cha2ds2_vasc_components<br/>(reuses fetch + extract)"]
    T4["summarize_recent_encounters<br/>Traverse(WithConcurrency(4), PartialResults)"]
    T5["prior_auth_assistant<br/>agent.Loop over T1–T4 as bindings"]
  end

  HTTPHandler --> HeaderExtract
  CtxInject --> T1
  CtxInject --> T2
  CtxInject --> T3
  CtxInject --> T4
  CtxInject --> T5
  Combinators -. composes .- T1
  Combinators -. composes .- T2
  Combinators -. composes .- T3
  Combinators -. composes .- T4
  Loop -. drives .- T5
end

FHIR[("FHIR server<br/>(EHR sandbox or real)")]
LLM[("Claude API<br/>via weft/llm<br/>(only for T5)")]

POInvoker ==> |"HTTP POST /mcp<br/>+ headers"| HTTPHandler
T1 ==> |"GET Authorization: Bearer …"| FHIR
T2 ==> FHIR
T4 ==> FHIR
T5 -.-> |"tool dispatch"| T1
T5 -.-> |"tool dispatch"| T2
T5 -.-> |"tool dispatch"| T4
T5 ==> |"messages + tool specs"| LLM
LLM ==> |"text or tool_use"| T5
HTTPHandler ==> |"JSON-RPC response"| POInvoker

classDef po fill:#eaf2ff,stroke:#3b6fd6,color:#0b2545,stroke-width:1.2px
classDef http fill:#fff7ea,stroke:#c97a1b,color:#3a2200,stroke-width:1.2px
classDef ctx fill:#e7f7ee,stroke:#1f8a4c,color:#0a3a1f,stroke-width:1.2px
classDef weft fill:#efe9ff,stroke:#6a4bd8,color:#221554,stroke-width:1.2px
classDef tools fill:#fdecec,stroke:#c0392b,color:#3a0a0a,stroke-width:1.2px
classDef ext fill:#222,stroke:#000,color:#fff,stroke-width:1.2px

class POEHR,POAdmin,POInvoker po
class HTTPHandler,InitResp http
class HeaderExtract,CtxInject ctx
class ArrowType,Combinators,Loop weft
class T1,T2,T3,T4,T5 tools
class FHIR,LLM ext
