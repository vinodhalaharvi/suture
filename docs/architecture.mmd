flowchart LR

%% =======================
%% PROMPT OPINION PLATFORM
%% =======================
subgraph PO["Prompt Opinion Platform"]
  direction TB
  POMarket["Marketplace<br/>(discoverable tools & agents)"]
  POAgent["Host Agent / Workspace<br/>(A2A + SHARP context)"]
  POEHR["EHR Session<br/>SMART on FHIR token<br/>+ patient context"]
  POAgent -- "invokes MCP tool" --> POBridge["SHARP Context Bridge<br/>(injects patient_id,<br/>FHIR token, scopes)"]
  POEHR --> POBridge
  POMarket -. "publishes / discovers" .- POAgent
end

%% =======================
%% YOUR GO MCP SERVER
%% =======================
subgraph GO["Your Go MCP Server (deployed on your infra)"]
  direction TB

  subgraph TRANS["mark3labs/mcp-go — wire protocol"]
    direction TB
    Transport["HTTP+SSE / stdio transport<br/>JSON-RPC 2.0"]
    Handlers["Tool registration<br/>list_tools / call_tool"]
  end

  subgraph WEFT["weft — categorical composition"]
    direction TB
    ArrowType["Arrow[A,B] = func(ctx, A) (B, error)"]
    Compose["Compose / Pipe / Par / Sum"]
    Apply["Apply: WithRetry · WithTimeout · WithTap"]
    Loop["llm.Loop (agent loop combinator)"]
  end

  subgraph SHARPMW["SHARP middleware (you write this thin layer)"]
    direction TB
    CtxExtract["Extract SHARP headers<br/>patient_id, fhir_base, bearer token"]
    CtxInject["Inject into context.Context<br/>(propagates through every Arrow)"]
    CtxExtract --> CtxInject
  end

  subgraph TOOLS["Your healthcare tools (each an Arrow)"]
    direction TB
    T1["fhirRead :: Arrow[Query, Bundle]<br/>GET {base}/Patient/{id}/...<br/>Bearer = SHARP token"]
    T2["riskScore :: Arrow[Bundle, Score]<br/>pure / model call"]
    T3["llmSummarize :: Arrow[Bundle, Narrative]<br/>llm.Claude(...) wrapped"]
    Composed["composedTool = Pipe3(fhirRead, riskScore, llmSummarize)<br/>+ WithRetry + WithTimeout"]
    T1 --> Composed
    T2 --> Composed
    T3 --> Composed
  end

  ServeAsTool["mcp.ServeAsTool[In,Out]<br/>(lift Arrow → MCP tool)"]

  Handlers --> CtxExtract
  CtxInject --> Composed
  Composed --> ServeAsTool
  ServeAsTool --> Handlers
  Apply -. wraps .- Composed
  Compose -. builds .- Composed
end

%% =======================
%% EXTERNAL FHIR
%% =======================
FHIR[("FHIR Server<br/>(EHR sandbox or real)")]

%% =======================
%% FLOWS
%% =======================
POBridge ==> |"MCP call_tool<br/>+ SHARP headers"| Transport
Transport --> Handlers
T1 ==> |"authenticated FHIR request"| FHIR
FHIR ==> T1
ServeAsTool ==> |"MCP response"| Transport
Transport ==> |"result"| POBridge
POBridge ==> POAgent

%% =======================
%% PUBLISHING PATH
%% =======================
GO -. "register manifest + endpoint" .-> POMarket

